@using DoctorManagement.Shared.DataTransferObjects
@using DoctorManagement.Presentation.ViewModels
@inherits CardComponent<SignupDoctorDto>
<div class="container py-2">
    <EditForm EditContext="CredentialsEditContext">
        <h5 class="text-primary">Login Details</h5>
        <DataAnnotationsValidator></DataAnnotationsValidator>
      
        <label for="@nameof(ViewModel.Data.Credentials.Username)">Username</label>
        <InputText @oninput="(val) => { ViewModel.Data.DoctorDetails.Contact.Email = (val.Value is not null ? val.Value.ToString() : string.Empty); }" id="@nameof(ViewModel.Data.Credentials.Username)" @bind-Value="ViewModel.Data.Credentials.Username" class="form-control" placeholder="Email"></InputText>
        <ValidationMessage For ="() => ViewModel.Data.Credentials.Username"></ValidationMessage>
       
        <label for="@nameof(ViewModel.Data.Credentials.Password)">Password</label>
        <InputText typeof="password" id="@nameof(ViewModel.Data.Credentials.Password)" @bind-Value="ViewModel.Data.Credentials.Password" class="form-control"></InputText>
        <ValidationMessage For ="() => ViewModel.Data.Credentials.Password"></ValidationMessage>
    </EditForm>
    <hr />
    <EditForm EditContext="AddressEditContext">
        <DataAnnotationsValidator></DataAnnotationsValidator>
        <h5 class="text-primary">Practice Details</h5>
        <label for="@nameof(ViewModel.Data.DoctorDetails.PracticeNumber)">Practice Number</label>
        <InputText id="@nameof(ViewModel.Data.DoctorDetails.PracticeNumber)" @bind-Value="ViewModel.Data.DoctorDetails.PracticeNumber" class="form-control"></InputText>
        <ValidationMessage For="() => ViewModel.Data.DoctorDetails.PracticeNumber"></ValidationMessage>
        
        <label for="@nameof(ViewModel.Data.DoctorDetails.Specialty)">Specialty</label>
        <InputText id="@nameof(ViewModel.Data.DoctorDetails.Specialty)" @bind-Value="ViewModel.Data.DoctorDetails.Specialty" class="form-control"></InputText>
        <ValidationMessage For="() => ViewModel.Data.DoctorDetails.Specialty"></ValidationMessage>
       
        <h6 class="text-primary pt-1">
            Practice site
        </h6>
        <label for="@nameof(ViewModel.Data.DoctorDetails.PracticeSite.HouseNumber)">House/Building No.</label>
        <InputText id="@nameof(ViewModel.Data.DoctorDetails.PracticeSite.HouseNumber)" @bind-Value="ViewModel.Data.DoctorDetails.PracticeSite!.HouseNumber" class="form-control"></InputText>
        <ValidationMessage For="() => ViewModel.Data.DoctorDetails.PracticeSite.HouseNumber"></ValidationMessage>
        
        <label for="@nameof(ViewModel.Data.DoctorDetails.PracticeSite.StreetName)">Street Name</label>
        <InputText id="@nameof(ViewModel.Data.DoctorDetails.PracticeSite.StreetName)" @bind-Value="ViewModel.Data.DoctorDetails.PracticeSite.StreetName" class="form-control"></InputText>
        <ValidationMessage For="() => ViewModel.Data.DoctorDetails.PracticeSite.StreetName"></ValidationMessage>

        <label for="@nameof(ViewModel.Data.DoctorDetails.PracticeSite.City)">City</label>
        <InputText id="@nameof(ViewModel.Data.DoctorDetails.PracticeSite.City)" @bind-Value="ViewModel.Data.DoctorDetails.PracticeSite.City" class="form-control"></InputText>
        <ValidationMessage For="() => ViewModel.Data.DoctorDetails.PracticeSite.City"></ValidationMessage>

        <label for="@nameof(ViewModel.Data.DoctorDetails.PracticeSite.State)">State/Province</label>
        <InputText id="@nameof(ViewModel.Data.DoctorDetails.PracticeSite.State)" @bind-Value="ViewModel.Data.DoctorDetails.PracticeSite.State" class="form-control"></InputText>
        <ValidationMessage For="() => ViewModel.Data.DoctorDetails.PracticeSite.State"></ValidationMessage>

        <label for="@nameof(ViewModel.Data.DoctorDetails.PracticeSite.Zip)">Zip/Postal Code</label>
        <InputText id="@nameof(ViewModel.Data.DoctorDetails.PracticeSite.Zip)" @bind-Value="ViewModel.Data.DoctorDetails.PracticeSite.Zip" class="form-control"></InputText>
        <ValidationMessage For="() => ViewModel.Data.DoctorDetails.PracticeSite.Zip"></ValidationMessage>

    </EditForm>
    <hr />
     <EditForm EditContext="ContactEditContext">
        <DataAnnotationsValidator></DataAnnotationsValidator>
        <h5 class="text-primary">Contact Details</h5>
        <label for="@nameof(ViewModel.Data.DoctorDetails.Contact.Phone)">Phone</label>
        <InputText id="@nameof(ViewModel.Data.DoctorDetails.Contact.Phone)" @bind-Value="ViewModel.Data.DoctorDetails.Contact.Phone" class="form-control"></InputText>
        <ValidationMessage For="() => ViewModel.Data.DoctorDetails.Contact.Phone"></ValidationMessage>

    </EditForm>
    <div class="d-flex justify-content-center py-1">
        <button @onclick="OnSubmitCliked" class="btn btn-primary">Submit</button>
        <button onclick="history.back();" class="btn btn-link">Back</button>
    </div>
</div>
