@using DoctorManagement.Presentation.Components.Base
@using DoctorManagement.Shared.DataTransferObjects
@using DoctorManagement.Presentation.ViewModels
@inherits CardComponent<SignupDto>
<div class="container py-2">
    <EditForm EditContext="CredentialsEditContext">
         
        <DataAnnotationsValidator></DataAnnotationsValidator>
        <h4 class="text-primary">Login Details</h4>
        <label>Username</label>
        <InputText @bind-Value="ViewModel.Data.Credentials.Username" @oninput = "(e) => { ViewModel.Data.Contact.Email = (e.Value is not null) ? e.Value.ToString() : string.Empty; }" class="form-control" placeholder="Email"></InputText>
        <ValidationMessage For="() => ViewModel.Data.Credentials.Username"></ValidationMessage>

        <label>Password</label>
        <InputText @bind-Value="ViewModel.Data.Credentials.Password" class="form-control" type="password"></InputText>
        <ValidationMessage For="() => ViewModel.Data.Credentials.Password"></ValidationMessage>
      
    </EditForm>
    <hr />
    <EditForm EditContext ="ContactEditContext">
        <DataAnnotationsValidator></DataAnnotationsValidator>
        <h4 class="text-primary">Contact Details</h4>
        <label>Phone</label>
        <InputText @bind-Value="ViewModel.Data.Contact.Phone" class="form-control"></InputText>
        <ValidationMessage For="() => ViewModel.Data.Contact.Phone"></ValidationMessage>
        <label>Email</label>
        <InputText @bind-Value="ViewModel.Data.Contact.Email" class="form-control" readonly></InputText>
        <ValidationMessage For="() => ViewModel.Data.Contact.Email"></ValidationMessage>
    </EditForm>
    <hr />
    <EditForm EditContext="AddressEditContext">
        <DataAnnotationsValidator></DataAnnotationsValidator>
        <h4 class="text-primary">Address 
            <ButtonComponent Loading="CurrentLocationButtonLoading" OnButtonClick=" async () => { await CurrentLocationButtonClick.InvokeAsync(); }">
            <Content>Use current location <i class="bi bi-geo-alt"></i></Content>
           </ButtonComponent>
        </h4>
        
        <label>House/Building No.</label>
        <InputText @bind-Value="ViewModel.Data.Address.HouseNumber" class="form-control" />
        <ValidationMessage For="() => ViewModel.Data.Address.HouseNumber"></ValidationMessage>

        <label>Street Name</label>
        <InputText @bind-Value="ViewModel.Data.Address.StreetName" class="form-control" />
        <ValidationMessage For="() => ViewModel.Data.Address.StreetName"></ValidationMessage>

        <label>City</label>
        <InputText @bind-Value="ViewModel.Data.Address.City" class="form-control"></InputText>
        <ValidationMessage For="() => ViewModel.Data.Address.City"></ValidationMessage>

        <label>State/Province</label>
        <InputText @bind-Value="ViewModel.Data.Address.State" class="form-control"></InputText>
        <ValidationMessage For="() => ViewModel.Data.Address.State"></ValidationMessage>

        <label>Zip/Postal Code</label>
        <InputText @bind-Value="ViewModel.Data.Address.Zip" class="form-control" />
        <ValidationMessage For="() => ViewModel.Data.Address.Zip">
        </ValidationMessage> 
    </EditForm>
     @if(this.ValidationErrors.Any()){
         <ul class="text-danger">
             @foreach(var error in this.ValidationErrors){
                 <li>@error</li>
             }
         </ul>
     }
    <div class="d-flex justify-content-center py-1">
        <ButtonComponent Loading="_submitLoading" Type="primary" OnButtonClick="OnSubmitClick">
            <Content>
                Submit
            </Content>
        </ButtonComponent>
        <ButtonComponent Type="link" href="/">
            <Content>
                Back
            </Content>
        </ButtonComponent>
    </div>
</div>
<ModalComponent ViewModel="ModalViewModel" Context="ModalContext">
    <Body>
        <div class="text-@(ServerMessage.Data ? "success":"danger")">
            @ServerMessage.Message
        </div>
    </Body>
    <Footer>
        <ButtonComponent Type="link" href="/">
            <Content>
                Go to login
            </Content>
        </ButtonComponent>
        <ButtonComponent Type="outline-secondary" OnButtonClick="OnCloseModal">
            <Content>
               Cancel
            </Content>
        </ButtonComponent>
    </Footer>
</ModalComponent>