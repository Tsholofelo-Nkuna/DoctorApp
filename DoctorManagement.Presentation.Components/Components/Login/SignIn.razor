@using DoctorManagement.Presentation.Components.Base
@using DoctorManagement.Shared.DataTransferObjects
@using DoctorManagement.Presentation.Interface.Base
@using DoctorManagement.Presentation.ViewModels
@inherits BaseComponent<LoginViewModel, LoginCredentialsDto>

<div class="vh-100" style="display:grid; grid-template-columns:1fr; grid-template-rows: 1fr; align-items:center">
    <CardComponent Context="cardContext"
        ViewModel="@(new CardComponentViewModel<LoginCredentialsDto>{ Title = " Find health worker", Data = this.ViewModel.Data})">
        <Header>
            <h3 class="text-primary px-1">
                @cardContext.Title
            </h3>
        </Header>
        <Body>
            <EditForm EditContext="ViewModel.EditContext">
                <DataAnnotationsValidator></DataAnnotationsValidator>
                 <label>@nameof(ViewModel.Data.Username)</label>
                <InputText  class="form-control" @bind-value="ViewModel.Data.Username" />
                <ValidationMessage For="()=>ViewModel.Data.Username"></ValidationMessage>

                <label>@nameof(ViewModel.Data.Password)</label>
                <InputText class="form-control" @bind-value="ViewModel.Data.Password" type="password" />
                <ValidationMessage For="() => ViewModel.Data.Password"></ValidationMessage>
            </EditForm>
        </Body>
        <Footer>
            <div class="d-flex flex-column">
                <button class="btn btn-primary me-1 d-block" @onclick="Login">Login</button>
                <div class="d-flex align-items-baseline justify-content-center">
                    <span style="font-size:0.77rem;">Don't have an account?</span>
                    <a href="/signup" class="btn btn-link">Sign up</a>
                </div>
                <div class="d-flex justify-content-center">
                    <span>Or</span>
                </div>
                <a href="signup/doctor"  class="d-block btn btn-secondary">Sign up as health worker</a>
            </div>
        </Footer>
    </CardComponent>
</div>
