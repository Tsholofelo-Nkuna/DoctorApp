@typeparam TDto where TDto: new()
@inherits BaseComponent<FormInputViewModel<TDto>, TDto>

<div class="@ViewModel.CssColClass mb-2">
    <label class="form-label">@GetDisplayName()</label>
    @switch (ViewModel.InputType)
    {
        case FormInputType.InputText:
           <input 
               type="@ViewModel.InputTextType"
               step="0.5"
               value="@GetValue()" 
               @onchange="OnInputChange" 
               @attributes ="AdditionalAttributes"
            class="form-control"/>
            break;
        case FormInputType.InputCheckbox:
            <input type="checkbox" value="@GetValue()"
                @oninput="OnInputChange"
                @attributes="AdditionalAttributes"
                class="form-check-input ms-2"
                checked="@(GetValue() == bool.TrueString)"/>
            break;
    }
</div>
