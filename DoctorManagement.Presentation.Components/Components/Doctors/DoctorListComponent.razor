@using DoctorManagement.Presentation.Components.Base
@using DoctorManagement.Presentation.ViewModels
@using DoctorManagement.Shared.DataTransferObjects
@inherits BaseComponent<DoctorListViewModel, List<DoctorDto>>

 <div class="row justify-content-center my-1">
    <div class="col-xs-12 col-sm-12 col-md-6">
        <input placeholder="City" class="form-control"/>
    </div>
   
</div>
@if(this.ViewModel.Data.Any()){

   @foreach(var item in ViewModel.Data){
         <div class="row justify-content-center">
            <div class="col-xs-12 col-sm-10 col-md-8 col-lg-6">
                <ProfileItemComponent ViewModel="@(new(){Title = item.PracticeNumber, Description = item.Specialty})"></ProfileItemComponent>
            </div>
        </div>
   }
}
else
{
   <div class="text-center fs-5">No Data</div>    
}
 