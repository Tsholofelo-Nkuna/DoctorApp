@using DoctorManagement.Presentation.Components.Patients
@inherits BaseComponent<DoctorAppointmentListViewModel, List<AppointmentDto>>

<h6 class="text-primary text-center mt-3">Appointments</h6>
@if (!ViewModel.Data.Any())
{
    <div class="text-center">No Data</div>
}
<div class="container">
    @foreach (var appointment in ViewModel.Data)
{
    <ProfileItemComponent ViewModel="@(new(){
                        Title = $"Scheduled date: {appointment.ScheduledDate:dd-MMM-yyyy}" ?? "",
                        Description = $"{appointment.AppointmentType?.Description}",
                        ProfileIcon = "bi bi-calendar3"
                    })">
        <AdditionalContent>
                @if (appointment.Patient?.PhotoContents?.Any() ?? false)
                {
                    <div>
                        <img style="width:5em;height:5em;background-image:url('@($"data:{appointment.Patient?.PhotoMimeType};base64,{Convert.ToBase64String(appointment.Patient.PhotoContents)}")');background-size:cover"/>
                    </div>
                }
                <div class="d-flex my-1">
                <div style="font-size:0.7rem;" class="badge @(AppointmentListComponent.BadgeColor(appointment))">@appointment?.AppointmentStatus?.Description</div>
            </div>
                @if (appointment is {PaymentMethod.Name : "MedicalAid"})
                {
                      <div class="my-1" style="font-size:0.7rem;">
                            <div>
                              <label class="me-2">Medical Aid Provider:</label><span>@appointment.Patient.MedicalAidProvider</span>
                          </div>
                          <div>
                              <label class="me-2">Medical Aid No.:</label><span>@appointment.Patient.MedicalAidNumber</span>
                          </div>
                            <div>
                              <label class="me-2">Plan Name:</label><span>@appointment.Patient.MedicalAidPlanName</span>
                          </div>
                      </div>
                }
                <div class="d-flex mb-2">
                <ButtonComponent 
                    Type="success btn-sm me-2"
                    OnButtonClick="async () => { await OnAcceptAppointment(appointment?.Id ?? Guid.Empty); }">
                    <Content>
                        Accept
                    </Content>
                </ButtonComponent>
                <ButtonComponent 
                    Type="danger btn-sm"
                    OnButtonClick="async () => { await OnRejectAppointment(appointment?.Id ?? Guid.Empty); }">
                    <Content>
                        Reject
                    </Content>
                </ButtonComponent>
            </div>
        </AdditionalContent>
    </ProfileItemComponent>
}
</div>