@using DoctorManagement.Presentation.Components.Patients
@inherits BaseComponent<DoctorAppointmentListViewModel, List<AppointmentDto>>

@foreach (var appointment in ViewModel.Data)
{
    <ProfileItemComponent ViewModel="@(new(){
                        Title = $"Scheduled date: {appointment.ScheduledDate:dd-MMM-yyyy}" ?? "",
                        Description = $"{appointment.AppointmentType?.Description}",
                        ProfileIcon = "bi bi-calendar3"
                    })">
        <AdditionalContent>
            <div class="d-flex my-1">
                <div style="font-size:0.7rem;" class="badge @(AppointmentListComponent.BadgeColor(appointment))">@appointment?.AppointmentStatus?.Description</div>
            </div>
            <div class="d-flex">
                <ButtonComponent Type="success">
                    <Content>
                        Accept
                    </Content>
                </ButtonComponent>
                <ButtonComponent Type="danger">
                    <Content>
                        Reject
                    </Content>
                </ButtonComponent>
            </div>
        </AdditionalContent>
    </ProfileItemComponent>
}