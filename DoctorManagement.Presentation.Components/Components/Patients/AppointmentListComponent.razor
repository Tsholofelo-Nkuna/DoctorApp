@using DoctorManagement.Shared.DataTransferObjects
@inherits BaseComponent<AppointmentListComponentViewModel, List<AppointmentDto>>

<div class="d-flex justify-content-center text-primary fw-bold my-1">
    Appointment Requests
</div>

@foreach(var appointment in ViewModel.Data){
    <ProfileItemComponent 
        ViewModel="@(new(){
                        Title = $"Scheduled date: {appointment.ScheduledDate:dd-MMM-yyyy}" ?? "",
                        Description = $"{appointment.AppointmentType?.Description}",
                        ProfileIcon = "bi bi-calendar3"
                    })">
       <AdditionalContent>
            <div style="font-size:0.7rem;">Consultation Fee: @($"{appointment?.Doctor?.ConsultationFeeDisaplay}")</div>
           <div class="d-flex my-1">
               <div style="font-size:0.7rem;" class="badge @(BadgeColor(appointment))">@appointment?.AppointmentStatus?.Description</div>
           </div>
       </AdditionalContent>
    </ProfileItemComponent>
}
