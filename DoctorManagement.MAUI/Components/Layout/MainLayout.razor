@inherits LayoutComponentBase
@if (this.NavBarPages.Any(url => url == NavigationManager.Uri) && MainLayout.RenderPatientLayout)
{
    <nav class="nav nav-tabs m-1 position-sticky sticky-top bg-light" style="font-size:0.67rem;">
        @foreach (var item in NavItems)
        {
                <a style="cursor:pointer;" @onclick="() => { OnTabLinkClicked(item); }" class="nav-link @(item.Index == ActiveIndex ? "active":"")">
                  <i class="@item.Icon me-1"></i>  @item.Text
                </a>
        }
    </nav>
}
else if (!MainLayout.RenderPatientLayout)
{
    <div class="d-flex flex-row-reverse m-3 position-sticky sticky-top">
        <a href="@Shared.Constants.RouteConstants.DoctorSettings">
            <i class="bi bi-gear text-primary"></i>
        </a>
    </div>
}
<div class="container">
    @if (!AppIsConnectedToInternet)
    {
        <div class="alert alert-warning border-warning position-sticky top-0 mt-1 z-3">
            No internet connection!
        </div>
    }
    @Body
</div>
